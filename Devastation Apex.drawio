        <mxCell id="hGbFFIk7rfYRunVNDtGK-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Devastation Apex Explanation&lt;/h1&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Quick Overview&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;Talent 1:&lt;/div&gt;&lt;div&gt;You get a stack of &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 255, 0));&quot;&gt;Rising Fury&lt;/font&gt; every 6s while in &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(204, 0, 0));&quot;&gt;Dragonrage&lt;/font&gt;, stacking up to 5.&lt;/div&gt;&lt;div&gt;You start with 1 Stack.&amp;nbsp;&amp;nbsp;&lt;br&gt;Each stack grants you 4% &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(126, 166, 224));&quot;&gt;Haste&lt;/font&gt;.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Talent 2:&lt;/div&gt;&lt;div&gt;You get a 8/15% &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 128, 0));&quot;&gt;damage &lt;/font&gt;buff when &lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 255, 0));&quot;&gt;Rising Fury&lt;/font&gt; has 5 stacks.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Talent 3:&lt;/div&gt;&lt;div&gt;When Dragonrage runs out, you keep&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(0, 255, 0));&quot;&gt;Rising Fury&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 204, 0); background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;for 4s for each stack gained&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Additionally you get an unconditional 4 casts of &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 102, 179));&quot;&gt;Unbound Flame&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&amp;nbsp;&lt;br&gt;The casts last until &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(204, 0, 0));&quot;&gt;Dragonrage&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; comes off cooldown or you spend them all.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="760" x="40" y="62" as="geometry" />
        </mxCell>
